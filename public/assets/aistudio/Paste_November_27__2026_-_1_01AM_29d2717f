<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Barcelona 26/27 Kits — Clearance | Solobo Sports</title>
<meta name="description" content="Barcelona 26/27 player-edition kits at clearance prices. Custom name and number printing. Cash on delivery across Bangladesh.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Big+Shoulders+Display:wght@700;800;900&family=Archivo:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
/* ==========================================================================
   SOLOBO — Clearance drop page
   One job: get the order. No header, no footer, no exits.
   Edit CONFIG and KITS in the <script> at the bottom.
   ========================================================================== */
:root{
  --chalk:#ECEDF0;        /* page */
  --paper:#FFFFFF;        /* surfaces */
  --ink:#15171D;          /* text */
  --ink-2:#4A4E59;        /* secondary text */
  --rule:#D6D8DE;         /* borders */
  --red:#E3141F;          /* Solobo action red */
  --red-press:#BF0D17;
  --go:#0F8A4B;           /* savings */
  /* set per kit by JS */
  --kit-stage:#0E1F4D; --kit-on:#FFFFFF; --kit-trim:#E9B526;

  --display:'Big Shoulders Display','Arial Narrow',Impact,sans-serif;
  --body:'Archivo',system-ui,-apple-system,'Segoe UI',sans-serif;
  --ease:cubic-bezier(.2,.7,.1,1);
}
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
[hidden]{display:none!important}
html{-webkit-text-size-adjust:100%;scroll-behavior:smooth}
body{font:400 16px/1.55 var(--body);color:var(--ink);background:var(--chalk);-webkit-font-smoothing:antialiased}
button{font:inherit;color:inherit;background:none;border:0;cursor:pointer}
input,textarea{font:inherit;color:inherit}
svg,img{display:block;max-width:100%}
:focus-visible{outline:3px solid var(--red);outline-offset:2px;border-radius:4px}
.vh{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}

/* ---------- Clock strip ---------- */
.strip{background:var(--ink);color:#fff;font-size:14px}
.strip-in{max-width:1360px;margin:0 auto;padding:10px 24px;display:flex;justify-content:space-between;align-items:center;gap:16px}
.brand{font:800 22px/1 var(--display);letter-spacing:.02em}
.brand span{color:var(--red)}
.clock{display:flex;align-items:center;gap:12px}
.clock-digits{font:800 22px/1 var(--display);font-variant-numeric:tabular-nums;letter-spacing:.04em}
.strip-note{color:#B9BCC6}

/* ---------- Drop: stage + buy panel ---------- */
.drop{max-width:1360px;margin:0 auto;padding:24px;display:grid;grid-template-columns:minmax(0,1.25fr) minmax(380px,.9fr);gap:24px;align-items:start}

.stage{position:sticky;top:24px;background:var(--kit-stage);color:var(--kit-on);border-radius:28px;overflow:hidden;aspect-ratio:5/5.2;min-height:520px;transition:background .5s var(--ease),color .5s var(--ease);isolation:isolate}
.stage-num{position:absolute;right:-3%;top:52%;transform:translateY(-50%);font:900 clamp(300px,42vw,640px)/.8 var(--display);letter-spacing:-.03em;color:transparent;-webkit-text-stroke:3px var(--kit-on);opacity:.22;z-index:-1;user-select:none;transition:opacity .3s}
.stage-top{position:absolute;inset:24px 24px auto 24px;display:flex;justify-content:space-between;align-items:flex-start;gap:12px}
.stage-kicker{font:800 clamp(32px,3.6vw,52px)/.92 var(--display);text-transform:uppercase;max-width:9ch}
.stage-kicker small{display:block;font:500 14px/1.3 var(--body);text-transform:none;opacity:.75;margin-top:10px;max-width:none}
.view{display:flex;background:rgba(0,0,0,.22);border-radius:999px;padding:4px;backdrop-filter:blur(6px)}
.view button{padding:8px 16px;border-radius:999px;font-weight:600;font-size:14px;color:var(--kit-on);opacity:.75}
.view button[aria-pressed="true"]{background:var(--kit-on);color:var(--kit-stage);opacity:1}
.shirt{position:absolute;inset:16% 10% 10%;display:grid;place-items:center}
.shirt svg{width:100%;height:100%;filter:drop-shadow(0 30px 40px rgba(0,0,0,.35));transition:transform .5s var(--ease),opacity .25s}
.shirt.out svg{opacity:0;transform:translateY(12px) scale(.97)}
.stage-foot{position:absolute;left:24px;right:24px;bottom:22px;display:flex;justify-content:space-between;align-items:flex-end;gap:12px;font-size:14px}
.off-tag{font:900 64px/.8 var(--display);letter-spacing:-.01em}
.off-tag small{display:block;font:600 14px/1.2 var(--body);margin-top:6px;opacity:.8}

/* ---------- Buy panel ---------- */
.panel{background:var(--paper);border-radius:28px;padding:32px}
.title{font:800 clamp(40px,4vw,60px)/.92 var(--display);text-transform:uppercase;letter-spacing:.005em}
.lede{color:var(--ink-2);margin-top:10px;max-width:44ch}
.proof{display:flex;gap:16px;margin-top:14px;font-size:14px;color:var(--ink-2)}
.proof b{color:var(--ink)}

.price{display:flex;align-items:baseline;gap:14px;margin-top:24px;padding-top:24px;border-top:1px solid var(--rule)}
.price-now{font:900 56px/.9 var(--display);color:var(--red);white-space:nowrap}
.price-was{white-space:nowrap;font-size:18px;color:var(--ink-2);text-decoration:line-through}
.price-save{margin-left:auto;font-weight:600;color:var(--go);font-size:15px}

.q{margin-top:28px}
.q-head{display:flex;justify-content:space-between;align-items:baseline;margin-bottom:12px}
.q-head h2{font:600 15px/1.2 var(--body)}
.q-head span,.q-head button{font-size:14px;color:var(--ink-2)}
.q-head button{text-decoration:underline;text-underline-offset:3px}

.kits{display:grid;grid-template-columns:repeat(4,1fr);gap:8px}
.kit{position:relative;border-radius:16px;aspect-ratio:1/1.12;background:var(--chalk);display:grid;place-items:center;padding:10px 6px 26px;border:2px solid transparent;transition:border-color .2s}
.kit svg{width:84%}
.kit[aria-pressed="true"]{border-color:var(--ink);background:#fff}
.kit-name{position:absolute;left:0;right:0;bottom:7px;font-size:12px;font-weight:600;text-align:center}
.kit-left{position:absolute;top:6px;right:6px;font-size:11px;font-weight:700;background:var(--ink);color:#fff;border-radius:999px;padding:1px 7px}
.kit:disabled{opacity:.35;cursor:not-allowed}

.sizes{display:grid;grid-template-columns:repeat(5,1fr);gap:8px}
.size{height:52px;border-radius:12px;border:1.5px solid var(--rule);font-weight:600;position:relative;background:#fff;transition:border-color .15s,background .15s}
.size:hover:not(:disabled){border-color:var(--ink)}
.size[aria-pressed="true"]{background:var(--ink);border-color:var(--ink);color:#fff}
.size:disabled{color:#A9ACB5;background:repeating-linear-gradient(-45deg,#fff 0 6px,#F3F4F6 6px 12px);cursor:not-allowed}
.size-left{display:block;font-size:11px;font-weight:500;color:var(--red);line-height:1;margin-top:2px}
.size[aria-pressed="true"] .size-left{color:#FFB3B7}
.size-hint{font-size:13px;color:var(--ink-2);margin-top:8px;min-height:20px}

.print{border:1.5px solid var(--rule);border-radius:16px;padding:16px;transition:border-color .2s}
.print.on{border-color:var(--ink)}
.print-toggle{display:flex;align-items:center;gap:12px;width:100%;text-align:left}
.switch{width:44px;height:26px;border-radius:999px;background:var(--rule);position:relative;flex:none;transition:background .2s}
.switch::after{content:"";position:absolute;top:3px;left:3px;width:20px;height:20px;border-radius:50%;background:#fff;box-shadow:0 1px 3px rgba(0,0,0,.25);transition:transform .2s var(--ease)}
.print.on .switch{background:var(--ink)}
.print.on .switch::after{transform:translateX(18px)}
.print-toggle b{display:block;font-weight:600}
.print-toggle small{color:var(--ink-2);font-size:13px}
.print-fields{display:none;grid-template-columns:1fr 92px;gap:8px;margin-top:14px}
.print.on .print-fields{display:grid}
.print-fields input{height:48px;border:1.5px solid var(--rule);border-radius:12px;padding:0 14px;text-transform:uppercase;font-weight:600;letter-spacing:.04em;background:#fff}
.print-fields input:focus{outline:0;border-color:var(--ink)}

.tiers{display:grid;grid-template-columns:repeat(3,1fr);border:1.5px solid var(--rule);border-radius:16px;overflow:hidden}
.tier{padding:12px 10px;font-size:13px;color:var(--ink-2);border-left:1.5px solid var(--rule);transition:background .2s}
.tier:first-child{border-left:0}
.tier b{display:block;font:800 22px/1 var(--display);color:var(--ink);margin-bottom:4px}
.tier.on{background:#E8F6EE;color:#0B5F34}
.tier.on b{color:var(--go)}

.buy{display:grid;grid-template-columns:auto 1fr;gap:10px;margin-top:28px}
.step{display:flex;align-items:center;border:1.5px solid var(--rule);border-radius:14px}
.step button{width:46px;height:58px;font-size:22px}
.step output{width:28px;text-align:center;font-weight:700;font-size:17px}
.cta{height:58px;border-radius:14px;background:var(--red);color:#fff;font-weight:700;font-size:17px;display:flex;align-items:center;justify-content:center;gap:10px;transition:background .15s,transform .1s}
.cta:hover{background:var(--red-press)}
.cta:active{transform:scale(.985)}
.cta-price{font:800 20px/1 var(--display);opacity:.9}
.add{margin-top:10px;width:100%;height:48px;border-radius:14px;border:1.5px solid var(--ink);font-weight:600}
.promise{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-top:22px;padding-top:20px;border-top:1px solid var(--rule);font-size:13px;color:var(--ink-2)}
.promise b{display:block;color:var(--ink);font-size:14px}

/* ---------- Kit rail ---------- */
.band{max-width:1360px;margin:0 auto;padding:64px 24px 0}
.band-head{display:flex;justify-content:space-between;align-items:end;gap:24px;margin-bottom:24px}
.band h2{font:800 clamp(36px,4.2vw,64px)/.92 var(--display);text-transform:uppercase;max-width:14ch}
.band-head p{color:var(--ink-2);max-width:40ch}
.rail{display:grid;grid-template-columns:repeat(4,1fr);gap:16px}
.card{border-radius:24px;overflow:hidden;background:var(--paper);text-align:left;display:flex;flex-direction:column}
.card-art{background:var(--c-stage);color:var(--c-on);aspect-ratio:1/1;display:grid;place-items:center;position:relative}
.card-art svg{width:72%;filter:drop-shadow(0 18px 22px rgba(0,0,0,.3))}
.card-body{padding:16px 18px 18px;display:flex;justify-content:space-between;align-items:end;gap:8px}
.card-body b{font-weight:600;display:block}
.card-body small{color:var(--ink-2);font-size:13px}
.card-price{font:800 26px/1 var(--display);color:var(--red);text-align:right}
.card-price s{display:block;font:400 13px/1.3 var(--body);color:var(--ink-2)}
.card.is-out{opacity:.5}

/* ---------- Details ---------- */
.specs{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}
.spec{background:var(--paper);border-radius:24px;padding:28px}
.spec h3{font:800 28px/1 var(--display);text-transform:uppercase;margin-bottom:10px}
.spec p{color:var(--ink-2);max-width:36ch}

.guide{display:grid;grid-template-columns:1fr 1.4fr;gap:16px;align-items:stretch}
.guide-note{background:var(--ink);color:#fff;border-radius:24px;padding:32px;display:flex;flex-direction:column;justify-content:space-between;gap:24px}
.guide-note h3{font:800 40px/.95 var(--display);text-transform:uppercase}
.guide-note p{color:#C4C7D0}
.table{background:var(--paper);border-radius:24px;padding:8px 24px;overflow-x:auto}
table{width:100%;border-collapse:collapse;font-variant-numeric:tabular-nums}
th,td{padding:16px 8px;text-align:left;border-bottom:1px solid var(--rule)}
tr:last-child td{border-bottom:0}
th{font-size:13px;font-weight:500;color:var(--ink-2)}
td:first-child{font:800 24px/1 var(--display)}

.faq{display:grid;grid-template-columns:1fr 1fr;gap:12px 16px}
.faq details{background:var(--paper);border-radius:20px;padding:0 24px}
.faq summary{list-style:none;cursor:pointer;padding:22px 0;font-weight:600;display:flex;justify-content:space-between;gap:16px}
.faq summary::-webkit-details-marker{display:none}
.faq summary::after{content:"";width:12px;height:12px;flex:none;margin-top:6px;border-right:2px solid var(--ink);border-bottom:2px solid var(--ink);transform:rotate(45deg);transition:transform .2s}
.faq details[open] summary::after{transform:rotate(-135deg)}
.faq p{color:var(--ink-2);padding-bottom:22px;max-width:56ch}

.close{max-width:1360px;margin:64px auto 0;padding:0 24px 120px}
.close-in{background:var(--kit-stage);color:var(--kit-on);border-radius:28px;padding:56px 40px;display:flex;justify-content:space-between;align-items:center;gap:24px;transition:background .5s}
.close-in h2{font:900 clamp(44px,6vw,96px)/.86 var(--display);text-transform:uppercase}
.close-in .cta{padding:0 32px;flex:none}
.small-print{text-align:center;font-size:13px;color:var(--ink-2);margin-top:20px}

/* ---------- Order drawer ---------- */
.scrim{position:fixed;inset:0;background:rgba(15,16,20,.5);opacity:0;pointer-events:none;transition:opacity .3s;z-index:50}
.drawer{position:fixed;top:0;right:0;bottom:0;width:min(480px,100%);background:var(--paper);z-index:51;transform:translateX(100%);transition:transform .4s var(--ease);display:flex;flex-direction:column}
body.open .scrim{opacity:1;pointer-events:auto}
body.open .drawer{transform:none}
body.open{overflow:hidden}
.d-head{display:flex;justify-content:space-between;align-items:center;padding:20px 24px;border-bottom:1px solid var(--rule)}
.d-head h2{font:800 30px/1 var(--display);text-transform:uppercase}
.x{width:40px;height:40px;border-radius:50%;background:var(--chalk);font-size:20px}
.d-body{flex:1;overflow-y:auto;padding:20px 24px 24px}
.lines{display:grid;gap:10px}
.line{display:grid;grid-template-columns:64px 1fr auto;gap:12px;align-items:center}
.line-art{width:64px;height:64px;border-radius:12px;background:var(--c-stage);display:grid;place-items:center}
.line-art svg{width:78%}
.line b{font-weight:600;font-size:15px;display:block;line-height:1.25}
.line small{font-size:13px;color:var(--ink-2)}
.line-r{text-align:right;font-weight:600}
.line-r button{display:block;margin-left:auto;font-size:12px;color:var(--ink-2);text-decoration:underline;font-weight:400}
.nudge{margin-top:14px;padding:12px 14px;border-radius:12px;background:#E8F6EE;color:#0B5F34;font-size:14px;font-weight:500;display:flex;justify-content:space-between;gap:10px;align-items:center}
.nudge button{font-weight:700;text-decoration:underline;white-space:nowrap}
.sum{display:grid;gap:8px;margin-top:18px;padding-top:16px;border-top:1px solid var(--rule);font-size:15px}
.sum div{display:flex;justify-content:space-between}
.sum .save{color:var(--go);font-weight:600}
.sum .total{font-weight:700;font-size:17px;padding-top:10px;margin-top:4px;border-top:1px solid var(--rule)}
.sum .total span:last-child{font:900 32px/1 var(--display)}

.form{margin-top:24px;display:grid;gap:14px}
.form h3{font-weight:600;font-size:15px}
.f label{display:block;font-size:14px;font-weight:500;margin-bottom:6px}
.f input,.f textarea{width:100%;height:52px;border:1.5px solid var(--rule);border-radius:12px;padding:0 14px;font-size:16px;background:#fff;transition:border-color .15s}
.f textarea{height:80px;padding:12px 14px;resize:vertical}
.f input:focus,.f textarea:focus{outline:0;border-color:var(--ink)}
.f .err{display:none;font-size:13px;color:var(--red);margin-top:5px}
.f.bad input,.f.bad textarea{border-color:var(--red)}
.f.bad .err{display:block}
.zones{display:grid;grid-template-columns:1fr 1fr;gap:8px}
.zone{border:1.5px solid var(--rule);border-radius:12px;padding:12px 14px;cursor:pointer;display:block}
.zone input{position:absolute;opacity:0}
.zone b{display:flex;justify-content:space-between;font-weight:600;font-size:15px}
.zone small{color:var(--ink-2);font-size:13px}
.zone:has(input:checked){border-color:var(--ink);box-shadow:inset 0 0 0 1px var(--ink)}
.zone:has(input:focus-visible){outline:3px solid var(--red);outline-offset:2px}
.d-foot{padding:16px 24px calc(16px + env(safe-area-inset-bottom));border-top:1px solid var(--rule)}
.d-foot .cta{width:100%}
.d-foot p{text-align:center;font-size:13px;color:var(--ink-2);margin-top:8px}
.empty{padding:28px;text-align:center;border:1.5px dashed var(--rule);border-radius:16px;color:var(--ink-2)}

.done{padding:48px 8px;text-align:center}
.done-mark{width:72px;height:72px;margin:0 auto 18px;border-radius:50%;background:var(--go);display:grid;place-items:center}
.done h3{font:800 40px/1 var(--display);text-transform:uppercase}
.done p{color:var(--ink-2);margin:10px auto 0;max-width:34ch}

/* ---------- Mobile bar + toast ---------- */
.bar{position:fixed;left:0;right:0;bottom:0;z-index:40;background:var(--paper);border-top:1px solid var(--rule);padding:10px 16px calc(10px + env(safe-area-inset-bottom));display:none;gap:12px;align-items:center;transform:translateY(105%);transition:transform .3s var(--ease)}
.bar.show{transform:none}
.bar-p{line-height:1.05}
.bar-p b{font:900 28px/1 var(--display);color:var(--red);display:block}
.bar-p small{font-size:12px;color:var(--ink-2)}
.bar .cta{flex:1;height:52px}
.toast{visibility:hidden;position:fixed;left:50%;bottom:24px;z-index:60;transform:translate(-50%,160%);background:var(--ink);color:#fff;padding:12px 18px;border-radius:12px;font-weight:500;font-size:15px;transition:transform .35s var(--ease);max-width:calc(100% - 32px)}
.toast.show{transform:translate(-50%,0);visibility:visible}
.wa{position:fixed;right:20px;bottom:24px;z-index:39;width:52px;height:52px;border-radius:50%;background:#25D366;color:#fff;display:grid;place-items:center;box-shadow:0 8px 20px rgba(0,0,0,.18)}
.wa svg{width:26px}

/* ---------- Responsive ---------- */
@media (max-width:1040px){
  .drop{grid-template-columns:1fr;padding:16px}
  .stage{position:relative;top:0;aspect-ratio:1/1;min-height:0}
  .rail{grid-template-columns:repeat(2,1fr)}
  .specs,.guide,.faq{grid-template-columns:1fr}
  .bar{display:flex}
  .wa{bottom:92px}
  .toast{bottom:92px}
}
@media (max-width:560px){
  .strip-in{padding:9px 16px}
  .strip-note{display:none}
  .panel{padding:22px;border-radius:24px}
  .stage{border-radius:24px}
  .stage-top{inset:16px 16px auto 16px}
  .stage-foot{left:16px;right:16px;bottom:14px}
  .off-tag{font-size:48px}
  .band{padding:48px 16px 0}
  .band-head{flex-direction:column;align-items:flex-start}
  .rail{display:flex;overflow-x:auto;scroll-snap-type:x mandatory;margin:0 -16px;padding:0 16px;scrollbar-width:none}
  .rail::-webkit-scrollbar{display:none}
  .card{flex:0 0 72%;scroll-snap-align:start}
  .close{padding:0 16px 110px}
  .close-in{flex-direction:column;align-items:flex-start;padding:36px 24px}
  .close-in .cta{width:100%}
  .promise{grid-template-columns:1fr;gap:10px}
  .stage{aspect-ratio:4/5}
  .shirt{inset:22% 6% 20%}
  .stage-kicker small{max-width:20ch}
  .price{flex-wrap:wrap;gap:4px 12px}
  .price-now{font-size:48px}
  .price-save{margin-left:0;width:100%}
  .kits{gap:6px}
  .q-head span{display:none}
  .wa{bottom:96px;right:14px;width:46px;height:46px}
  .kit-name{font-size:11px}
  .sizes{gap:6px}
  .drawer{top:auto;height:92dvh;border-radius:24px 24px 0 0;transform:translateY(100%)}
}
@media (prefers-reduced-motion:reduce){*,*::before,*::after{transition:none!important;animation:none!important;scroll-behavior:auto!important}}
</style>
</head>
<body>

<!-- Clock strip -->
<div class="strip">
  <div class="strip-in">
    <div class="brand">SOLOBO<span>.</span></div>
    <div class="clock" role="timer" aria-live="off">
      <span class="strip-note">Clearance prices end in</span>
      <span class="clock-digits" id="clock">18:00:00</span>
    </div>
  </div>
</div>

<main>
<!-- ================= Drop ================= -->
<section class="drop" aria-label="Product">
  <div class="stage" id="stage">
    <div class="stage-num" id="stageNum" aria-hidden="true">10</div>
    <div class="stage-top">
      <p class="stage-kicker" id="stageKicker">Home kit<small id="stageSub">Blaugrana stripes, gold trim</small></p>
      <div class="view" role="group" aria-label="Shirt view">
        <button type="button" data-view="front" aria-pressed="true">Front</button>
        <button type="button" data-view="back" aria-pressed="false">Back</button>
      </div>
    </div>
    <div class="shirt" id="shirt"></div>
    <div class="stage-foot">
      <div class="off-tag" id="offTag">40% off<small id="stockLine">12 left in stock</small></div>
    </div>
  </div>

  <div class="panel">
    <h1 class="title" id="title">Barcelona 26/27</h1>
    <p class="lede">Player-edition fit in breathable match fabric. Last stock of the season, priced to clear.</p>
    <!-- Replace with your real numbers -->
    <div class="proof"><span><b id="rating">4.8</b> average from <b id="ratingCount">324</b> buyers</span></div>

    <div class="price">
