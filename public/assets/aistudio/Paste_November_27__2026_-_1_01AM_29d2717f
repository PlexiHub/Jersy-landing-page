<script>
/* ==========================================================================
   CONFIG — edit these to launch a new clearance page
   ========================================================================== */
const CONFIG = {
  hours: 18,                       // countdown per visitor; set `endsAt` for a fixed deadline
  endsAt: null,                    // e.g. '2026-11-30T23:59:00+06:00'
  shipping: { inside: 70, outside: 130 },
  freeShippingFrom: 3,
  tiers: [                         // discount per shirt
    { min: 1, off: 0,   label: '1 shirt',  note: 'Clearance price' },
    { min: 2, off: 100, label: '2 shirts', note: 'Tk 100 off each' },
    { min: 3, off: 150, label: '3+',       note: 'Tk 150 off each, free delivery' }
  ],
  printPrice: 250,
  defaultBack: { name: 'SOLOBO', num: '10' },
  orderEndpoint: '',               // POST JSON here, e.g. '/api/orders/landing'. Empty = demo mode.
};

/* image / imageBack: your product photo URLs (transparent PNG works best).
   Leave empty to use the drawn placeholder shirt. */
const KITS = [
  { id:'fcb-home-2627',  name:'Barcelona Home 26/27',  short:'Home',  note:'Blaugrana stripes, gold trim',
    price:890, was:1490, sizes:{S:0,M:3,L:5,XL:3,XXL:1}, image:'', imageBack:'',
    look:{ pattern:'stripes', a:'#A2214A', b:'#1A3F94', trim:'#E9B526', text:'#E9B526' },
    stage:'#0E1F4D', on:'#FFFFFF' },
  { id:'fcb-away-2627',  name:'Barcelona Away 26/27',  short:'Away',  note:'Sunflower with garnet detail',
    price:850, was:1450, sizes:{S:1,M:2,L:2,XL:1,XXL:0}, image:'', imageBack:'',
    look:{ pattern:'solid', a:'#F2CF3A', b:'#F2CF3A', trim:'#8E1638', text:'#8E1638' },
    stage:'#4A0C22', on:'#F2CF3A' },
  { id:'fcb-third-2627', name:'Barcelona Third 26/27', short:'Third', note:'Carbon black, red flash',
    price:850, was:1450, sizes:{S:0,M:0,L:2,XL:2,XXL:0}, image:'', imageBack:'',
    look:{ pattern:'solid', a:'#1C1D22', b:'#1C1D22', trim:'#E3141F', text:'#F4F4F5' },
    stage:'#2A2B31', on:'#FFFFFF' },
  { id:'fcb-retro-09',   name:'Barcelona Retro 2009',  short:'Retro 09', note:'The treble season, half-and-half',
    price:990, was:1690, sizes:{S:1,M:2,L:3,XL:2,XXL:1}, image:'', imageBack:'',
    look:{ pattern:'halves', a:'#A2214A', b:'#1A3F94', trim:'#E9B526', text:'#E9B526' },
    stage:'#5A0E27', on:'#FFFFFF' },
];

/* ==========================================================================
   Helpers
   ========================================================================== */
const $ = s => document.querySelector(s);
const tk = n => 'Tk ' + Math.round(n).toLocaleString('en-IN');
const esc = s => String(s).replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const stockOf = k => Object.values(k.sizes).reduce((a,b)=>a+b,0);
let uid = 0;

/* Placeholder shirt — shaded, with collar, cuffs and seams. */
function shirt(k, side='front', back=CONFIG.defaultBack){
  const L = k.look, id = 's' + (uid++);
  const img = side === 'back' ? k.imageBack : k.image;
  if (img) return `<img src="${esc(img)}" alt="${esc(k.name)} ${side}" loading="lazy">`;
  let fill;
  if (L.pattern === 'stripes'){
    fill = `<pattern id="${id}p" width="44" height="10" patternUnits="userSpaceOnUse" x="12"><rect width="22" height="10" fill="${L.a}"/><rect x="22" width="22" height="10" fill="${L.b}"/></pattern>`;
  } else if (L.pattern === 'halves'){
    fill = `<linearGradient id="${id}p" x1="0" x2="1"><stop offset=".5" stop-color="${side==='back'?L.b:L.a}"/><stop offset=".5" stop-color="${side==='back'?L.a:L.b}"/></linearGradient>`;
  } else {
    fill = `<linearGradient id="${id}p"><stop stop-color="${L.a}"/></linearGradient>`;
  }
  const body = 'M78 30 L46 40 L10 74 L34 118 L58 104 L58 226 Q120 236 182 226 L182 104 L206 118 L230 74 L194 40 L162 30 Q120 54 78 30Z';
  const front = side === 'front';
  const nm = esc((back.name || '').toUpperCase().slice(0,12)), no = esc(back.num || '');
  const decor = front
    ? `<path d="M147 70 l10 0 0 9 q0 7 -5 10 q-5 -3 -5 -10z" fill="${L.trim}"/>
       <path d="M86 72 q5 -4 10 0 q-5 4 -10 0z" fill="${L.trim}" opacity=".9"/>
       <rect x="92" y="112" width="56" height="12" rx="2" fill="${L.text}" opacity=".85"/>`
    : `<text x="120" y="96" text-anchor="middle" font-family="Big Shoulders Display, Arial Narrow, sans-serif" font-weight="800" font-size="${nm.length>8?17:21}" letter-spacing="1.5" fill="${L.text}">${nm}</text>
       <text x="120" y="182" text-anchor="middle" font-family="Big Shoulders Display, Arial Narrow, sans-serif" font-weight="900" font-size="82" fill="${L.text}">${no}</text>`;
  return `<svg viewBox="0 0 240 240" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
  <defs>${fill}
    <linearGradient id="${id}s" x1="0" x2="1"><stop offset="0" stop-color="#000" stop-opacity=".28"/><stop offset=".22" stop-color="#000" stop-opacity="0"/><stop offset=".55" stop-color="#fff" stop-opacity=".07"/><stop offset=".8" stop-color="#000" stop-opacity="0"/><stop offset="1" stop-color="#000" stop-opacity=".3"/></linearGradient>
    <linearGradient id="${id}v" y1="0" y2="1" x1="0" x2="0"><stop offset=".6" stop-color="#000" stop-opacity="0"/><stop offset="1" stop-color="#000" stop-opacity=".22"/></linearGradient>
    <clipPath id="${id}c"><path d="${body}"/></clipPath>
  </defs>
  <path d="${body}" fill="url(#${id}p)"/>
  <g clip-path="url(#${id}c)">
    ${decor}
    <rect width="240" height="240" fill="url(#${id}s)"/>
    <rect width="240" height="240" fill="url(#${id}v)"/>
    <path d="M58 104 L58 230 M182 104 L182 230" stroke="#000" stroke-opacity=".18" stroke-width="1.2"/>
    <path d="M78 30 Q72 70 58 104 M162 30 Q168 70 182 104" stroke="#000" stroke-opacity=".12" stroke-width="1.2" fill="none"/>
    <path d="M10 74 L34 118 L40 115 L16 71Z M230 74 L206 118 L200 115 L224 71Z" fill="${L.trim}"/>
  </g>
  ${front
    ? `<path d="M78 30 Q120 54 162 30 L156 27 Q120 44 84 27Z" fill="${L.trim}"/><path d="M84 27 Q120 44 156 27 L148 25 Q120 36 92 25Z" fill="#000" opacity=".35"/>`
    : `<path d="M78 30 Q120 42 162 30 L156 27 Q120 36 84 27Z" fill="${L.trim}"/>`}
  </svg>`;
}

/* ==========================================================================
   State
   ========================================================================== */
const S = { k:0, size:null, qty:1, print:false, view:'front', cart:[] };
const kit = () => KITS[S.k];
const back = () => S.print ? { name: $('#pName').value.trim() || CONFIG.defaultBack.name, num: $('#pNum').value.trim() || CONFIG.defaultBack.num } : CONFIG.defaultBack;
const cartQty = () => S.cart.reduce((a,c)=>a+c.qty,0);
const tierFor = n => [...CONFIG.tiers].reverse().find(t => n >= t.min) || CONFIG.tiers[0];

/* ==========================================================================
   Render
   ========================================================================== */
function paintStage(animate){
  const k = kit(), root = document.documentElement.style;
  root.setProperty('--kit-stage', k.stage); root.setProperty('--kit-on', k.on);
  const draw = () => { $('#shirt').innerHTML = shirt(k, S.view, back()); };
  if (animate){ $('#shirt').classList.add('out'); setTimeout(()=>{ draw(); $('#shirt').classList.remove('out'); }, 200); }
  else draw();
  $('#stageNum').textContent = back().num || '10';
  $('#stageKicker').firstChild.nodeValue = k.short + (k.short.length < 6 ? ' kit' : '');
  $('#stageSub').textContent = k.note;
  const left = stockOf(k);
  $('#offTag').firstChild.nodeValue = Math.round((1 - k.price/k.was)*100) + '% off';
  $('#stockLine').textContent = left ? `${left} left in stock` : 'Sold out';
  document.querySelectorAll('[data-view]').forEach(b => b.setAttribute('aria-pressed', b.dataset.view === S.view));
}
function paintPanel(){
  const k = kit();
  $('#title').textContent = k.name.replace(/ (Home|Away|Third|Retro)/,'').trim();
  $('#priceNow').textContent = tk(k.price);
  $('#priceWas').textContent = tk(k.was);
  $('#priceSave').textContent = 'You save ' + tk(k.was - k.price);
  $('#kitName').textContent = k.short;
  $('#kits').innerHTML = KITS.map((x,i) => {
    const left = stockOf(x);
    return `<button type="button" class="kit" data-k="${i}" aria-pressed="${i===S.k}" ${left?'':'disabled'} aria-label="${esc(x.short)}, ${tk(x.price)}${left?'':' sold out'}">
      ${left && left <= 6 ? `<span class="kit-left">${left} left</span>` : ''}${shirt(x)}<span class="kit-name">${esc(x.short)}</span></button>`;
  }).join('');
  $('#sizes').innerHTML = Object.entries(k.sizes).map(([s,n]) =>
    `<button type="button" class="size" data-s="${s}" ${n?'':'disabled'} aria-pressed="${S.size===s}" aria-label="${s}${n?`, ${n} left`:', sold out'}">${s}${n && n<=2 ? `<span class="size-left">${n} left</span>` : ''}</button>`).join('');
  const n = S.size ? k.sizes[S.size] : 0;
  $('#sizeHint').textContent = S.size ? (n <= 2 ? `Only ${n} left in ${S.size}. Order now to hold it.` : `${S.size} is in stock.`) : 'Between sizes? Take the larger one.';
  paintPrice();
}
function paintPrice(){
  const k = kit(), unit = k.price + (S.print ? CONFIG.printPrice : 0);
  const n = cartQty() + S.qty, t = tierFor(n);
  const each = unit - t.off;
  $('#ctaPrice').textContent = tk(each * S.qty);
  $('#closePrice').textContent = tk(k.price);
  $('#barPrice').textContent = tk(each * S.qty);
  $('#barMeta').textContent = `${k.short} · ${S.size ? 'size ' + S.size : 'pick a size'}`;
  $('#tiers').innerHTML = CONFIG.tiers.map(x => `<div class="tier ${x===t?'on':''}"><b>${x.label}</b>${x.note}</div>`).join('');
}
function paintRail(){
  $('#rail').innerHTML = KITS.map((x,i) => {
    const left = stockOf(x);
    return `<button type="button" class="card ${left?'':'is-out'}" data-k="${i}" style="--c-stage:${x.stage};--c-on:${x.on}">
      <div class="card-art">${shirt(x)}</div>
      <div class="card-body"><div><b>${esc(x.short)}</b><small>${left ? left + ' left' : 'Sold out'}</small></div>
      <div class="card-price">${tk(x.price)}<s>${tk(x.was)}</s></div></div></button>`;
  }).join('');
}

/* ==========================================================================
   Cart + drawer
   ========================================================================== */
function addCurrent(){
  const k = kit();
  if (!S.size){ toast('Pick a size first.'); const el = $('#sizes'); el.scrollIntoView({behavior:'smooth', block:'center'}); el.animate([{transform:'translateX(0)'},{transform:'translateX(-6px)'},{transform:'translateX(6px)'},{transform:'translateX(0)'}],{duration:280}); return false; }
  const pr = S.print ? { name: $('#pName').value.trim().toUpperCase(), num: $('#pNum').value.trim() } : null;
  if (pr && !pr.name && !pr.num){ toast('Type a name or number to print.'); $('#pName').focus(); return false; }
  const key = [k.id, S.size, pr ? pr.name + '#' + pr.num : ''].join('|');
  const max = k.sizes[S.size];
  const have = S.cart.filter(c => c.id === k.id && c.size === S.size).reduce((a,c)=>a+c.qty,0);
  if (have >= max){ toast(`All ${max} in ${S.size} are already in your order.`); return false; }
  const add = Math.min(S.qty, max - have);
  const hit = S.cart.find(c => c.key === key);
  if (hit) hit.qty += add; else S.cart.push({ key, id:k.id, size:S.size, qty:add, print:pr });
  S.qty = 1; $('#qty').textContent = 1;
  paintPrice(); paintCart();
  return true;
}
function totals(){
  const n = cartQty(), t = tierFor(n);
  let sub = 0;
  S.cart.forEach(c => { const k = KITS.find(x=>x.id===c.id); sub += (k.price + (c.print ? CONFIG.printPrice : 0)) * c.qty; });
  const disc = n ? t.off * n : 0;
  const zone = document.querySelector('input[name=zone]:checked').value;
  const ship = !n ? 0 : (n >= CONFIG.freeShippingFrom ? 0 : CONFIG.shipping[zone]);
  return { n, sub, disc, ship, total: sub - disc + ship };
}
function paintCart(){
  const box = $('#lines');
  box.innerHTML = S.cart.length ? S.cart.map((c,i) => {
    const k = KITS.find(x=>x.id===c.id), unit = k.price + (c.print ? CONFIG.printPrice : 0);
    return `<div class="line"><div class="line-art" style="--c-stage:${k.stage}">${shirt(k)}</div>
      <div><b>${esc(k.name)}</b><small>Size ${c.size} · Qty ${c.qty}${c.print ? ` · Print ${esc(c.print.name)} ${esc(c.print.num)}` : ''}</small></div>
      <div class="line-r">${tk(unit*c.qty)}<button type="button" data-rm="${i}">Remove</button></div></div>`;
  }).join('') : `<div class="empty">Your order is empty. Pick a kit and size to start.</div>`;
  const r = totals();
  $('#sSub').textContent = tk(r.sub);
  $('#sDiscRow').hidden = !r.disc;
  $('#sDiscLabel').textContent = `Bundle saving, ${r.n} shirts`;
  $('#sDisc').textContent = '−' + tk(r.disc);
  $('#sShip').textContent = r.n && r.ship === 0 ? 'Free' : tk(r.ship);
  $('#sTotal').textContent = tk(r.total);
  $('#submitPrice').textContent = tk(r.total);
  $('#zIn').textContent = r.n >= CONFIG.freeShippingFrom ? 'Free' : tk(CONFIG.shipping.inside);
  $('#zOut').textContent = r.n >= CONFIG.freeShippingFrom ? 'Free' : tk(CONFIG.shipping.outside);
  const next = CONFIG.tiers.find(t => t.min > r.n);
  $('#nudge').hidden = !(r.n && next);
  if (r.n && next){
    const more = next.min - r.n;
    $('#nudgeText').textContent = `Add ${more} more shirt${more>1?'s':''} and save ${tk(next.off*next.min - tierFor(r.n).off*r.n)}${next.min >= CONFIG.freeShippingFrom ? ' plus free delivery' : ''}.`;
  }
  $('#sum').hidden = !S.cart.length;
}
let lastFocus;
function openDrawer(){
  lastFocus = document.activeElement;
  document.body.classList.add('open'); $('#drawer').setAttribute('aria-hidden','false');
  setTimeout(()=> (S.cart.length ? $('#name') : $('#dClose')).focus({preventScroll:true}), 350);
}
function closeDrawer(){
  document.body.classList.remove('open'); $('#drawer').setAttribute('aria-hidden','true');
  if (lastFocus) lastFocus.focus({preventScroll:true});
}
function orderNow(){ if (!S.cart.length || S.size){ if (S.size && !addCurrent()) return; if (!S.cart.length && !addCurrent()) return; } openDrawer(); }

/* ==========================================================================
   Events
   ========================================================================== */
document.addEventListener('click', e => {
  const k = e.target.closest('[data-k]');
  if (k){
    const i = +k.dataset.k; if (!stockOf(KITS[i])) return;
    if (k.classList.contains('card')) window.scrollTo({top:0, behavior:'smooth'});
    if (i !== S.k){ S.k = i; S.size = null; S.qty = 1; $('#qty').textContent = 1; paintStage(true); paintPanel(); }
    return;
  }
  const s = e.target.closest('.size[data-s]');
  if (s){ S.size = s.dataset.s; S.qty = Math.min(S.qty, kit().sizes[S.size]); $('#qty').textContent = S.qty; paintPanel(); return; }
  const v = e.target.closest('[data-view]');
  if (v){ S.view = v.dataset.view; paintStage(true); return; }
  const rm = e.target.closest('[data-rm]');
  if (rm){ S.cart.splice(+rm.dataset.rm, 1); paintCart(); paintPrice(); }
});
$('#minus').onclick = () => { S.qty = Math.max(1, S.qty - 1); $('#qty').textContent = S.qty; paintPrice(); };
$('#plus').onclick = () => {
  const max = S.size ? kit().sizes[S.size] : 5;
  if (S.qty >= max){ toast(S.size ? `Only ${max} left in ${S.size}.` : 'Pick a size first.'); return; }
  S.qty++; $('#qty').textContent = S.qty; paintPrice();
};
$('#printToggle').onclick = () => {
  S.print = !S.print;
  $('#print').classList.toggle('on', S.print);
  $('#printToggle').setAttribute('aria-expanded', S.print);
  if (S.print){ S.view = 'back'; setTimeout(()=>$('#pName').focus(), 50); }
  paintStage(true); paintPrice();
};
const livePrint = () => { S.view = 'back'; $('#shirt').innerHTML = shirt(kit(), 'back', back()); $('#stageNum').textContent = back().num || '10'; document.querySelectorAll('[data-view]').forEach(b => b.setAttribute('aria-pressed', b.dataset.view === 'back')); };
$('#pName').addEventListener('input', e => { e.target.value = e.target.value.replace(/[^a-zA-Z .'-]/g,'').toUpperCase(); livePrint(); });
$('#pNum').addEventListener('input', e => { e.target.value = e.target.value.replace(/\D/g,''); livePrint(); });

$('#orderNow').onclick = () => { if (addCurrent()) openDrawer(); };
$('#addAnother').onclick = () => { if (addCurrent()){ toast(`Added. Pick your next kit.`); S.size = null; paintPanel(); $('#kits').scrollIntoView({behavior:'smooth', block:'center'}); } };
$('#barCta').onclick = () => { if (S.size){ if (addCurrent()) openDrawer(); } else if (S.cart.length) openDrawer(); else { addCurrent(); } };
$('#closeCta').onclick = () => { if (S.cart.length) openDrawer(); else { window.scrollTo({top:0, behavior:'smooth'}); toast('Pick a kit and size to start.'); } };
$('#toGuide').onclick = () => document.getElementById('guide').scrollIntoView({behavior:'smooth'});
$('#nudgeBtn').onclick = () => { closeDrawer(); S.size = null; paintPanel(); window.scrollTo({top:0, behavior:'smooth'}); };
$('#dClose').onclick = closeDrawer; $('#scrim').onclick = closeDrawer;
document.addEventListener('keydown', e => { if (e.key === 'Escape' && document.body.classList.contains('open')) closeDrawer(); });
document.querySelectorAll('input[name=zone]').forEach(r => r.addEventListener('change', paintCart));

$('#phone').addEventListener('input', e => { e.target.value = e.target.value.replace(/[০-৯]/g, d => '০১২৩৪৫৬৭৮৯'.indexOf(d)).replace(/[^\d+]/g,''); });
['name','phone','addr'].forEach(id => $('#'+id).addEventListener('input', () => $('#'+id).closest('.f').classList.remove('bad')));

$('#form').addEventListener('submit', async e => {
  e.preventDefault();
  if (!S.cart.length){ toast('Your order is empty.'); return; }
  const name = $('#name').value.trim(), phone = $('#phone').value.trim().replace(/^\+?88/,''), addr = $('#addr').value.trim();
  const checks = [['#fName', name.length >= 2], ['#fPhone', /^01[3-9]\d{8}$/.test(phone)], ['#fAddr', addr.length >= 10]];
  let first = null;
  checks.forEach(([id, ok]) => { $(id).classList.toggle('bad', !ok); if (!ok && !first) first = id; });
  if (first){ $(first).querySelector('input,textarea').focus(); return; }

  const r = totals();
  const payload = {
    customer: { name, phone, address: addr, zone: document.querySelector('input[name=zone]:checked').value },
    items: S.cart.map(c => ({ product_id: c.id, size: c.size, qty: c.qty, print: c.print })),
    subtotal: r.sub, discount: r.disc, shipping: r.ship, total: r.total,
    payment: 'COD', source: 'clearance-landing', page: location.pathname
  };
  const btn = $('#submit'); btn.disabled = true; btn.firstChild.nodeValue = 'Placing order… ';
  try{
    if (CONFIG.orderEndpoint){
      const res = await fetch(CONFIG.orderEndpoint, { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify(payload) });
      if (!res.ok) throw new Error(res.status);
    } else { console.log('[demo] order payload', payload); await new Promise(r => setTimeout(r, 700)); }
    // if (window.fbq) fbq('track', 'Purchase', { value: r.total, currency: 'BDT' });
    $('#dBody').innerHTML = `<div class="done"><div class="done-mark"><svg width="34" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="3"><path d="m5 12 5 5 9-10"/></svg></div>
      <h3>Order placed</h3><p>Thanks, ${esc(name.split(' ')[0])}. We'll call ${esc(phone)} shortly to confirm. Pay ${tk(r.total)} when it arrives.</p></div>`;
    $('#dFoot').hidden = true; S.cart = []; paintPrice();
  } catch(err){
    toast('Order not sent. Check your connection and try again, or message us on WhatsApp.');
  } finally { btn.disabled = false; btn.firstChild.nodeValue = 'Place order '; }
});

/* Toast */
let tt; function toast(m){ const t = $('#toast'); t.textContent = m; t.classList.add('show'); clearTimeout(tt); tt = setTimeout(()=>t.classList.remove('show'), 2400); }

/* Countdown */
(function(){
  let end = CONFIG.endsAt ? Date.parse(CONFIG.endsAt) : 0;
  if (!end){
    try { end = +localStorage.getItem('solobo_clear_end'); } catch(_){}
    if (!end || end < Date.now()){ end = Date.now() + CONFIG.hours*3600e3; try { localStorage.setItem('solobo_clear_end', end); } catch(_){} }
  }
  const p = n => String(n).padStart(2,'0');
  const tick = () => { const d = Math.max(0, end - Date.now()); $('#clock').textContent = `${p(Math.floor(d/3600e3))}:${p(Math.floor(d%3600e3/60e3))}:${p(Math.floor(d%60e3/1e3))}`; };
  tick(); setInterval(tick, 1000);
})();

/* Mobile bar: show once the main CTA scrolls away */
new IntersectionObserver(([en]) => $('#bar').classList.toggle('show', !en.isIntersecting && en.boundingClientRect.top < 0)).observe($('#orderNow'));

/* Init */
paintStage(false); paintPanel(); paintRail(); paintCart();
</script>
</body>
